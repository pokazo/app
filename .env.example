APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-at-least-32-characters-long
DATABASE_URL=postgres://pokazo:pokazo@localhost:5432/pokazo
REDIS_URL=redis://localhost:6379
# Parallel BullMQ workers (many generates at once; edits on a separate queue)
# DECK_GENERATE_CONCURRENCY=8
# DECK_EDIT_CONCURRENCY=4
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Yandex Cloud Search API (web research before outline) — same keys as yandex-search-mcp
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
# Yandex Images HTTP service (landing VPS) — empty disables yandex-image-* tools
# YANDEX_IMAGES_URL=http://91.207.75.72:3021
YANDEX_IMAGES_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Показо <noreply@pokazo.ru>
# Inbox for the public /contact form
CONTACT_TO=mail@antonbutov.com
OPENROUTER_API_KEY=
# On 80.87.196.33 OpenRouter is blocked; prod uses landing egress http://91.207.75.72:8787/api/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_OUTLINE_MODEL=openai/gpt-4.1-mini
LLM_COMPOSE_MODEL=deepseek/deepseek-v4-flash
LLM_HTTP_REFERER=https://pokazo.ru
LLM_APP_TITLE=Pokazo
UNSPLASH_ACCESS_KEY=
# API VPS (80.87.196.33) cannot reach Unsplash; prod uses landing egress:
# UNSPLASH_API_BASE=http://91.207.75.72:8788
# UNSPLASH_IMAGES_BASE=http://91.207.75.72:8789
UNSPLASH_API_BASE=
UNSPLASH_IMAGES_BASE=
# OpenAI Images — cheap generate when Unsplash is empty/off-topic (gpt-image-1-mini, low)
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1-mini
# OPENAI_IMAGE_API_BASE=https://api.openai.com/v1
DECK_DATA_DIR=./data/decks
# User-attached images for upload-images MCP (kept for error triage; separate from decks)
UPLOAD_DATA_DIR=./data/uploads
# Long-lived Slidev (dev) pool for owner HMR edits (~600MB RSS each; max 2 on 8GB VPS)
# SLIDEV_DEV_POOL=true
# SLIDEV_DEV_POOL_MAX=2
# SLIDEV_DEV_POOL_IDLE_MS=600000
VITE_API_URL=
